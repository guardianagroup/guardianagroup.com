g(cases.length).padStart(2, '0'), casePct: lv.casePct, casePctOld: Math.round(((st.caseIdx % cases.length) + 0) / cases.length * 100), cases,\n      prevCase: () => { this.caseTick = 0; this.setState(s => ({ caseIdx: (s.caseIdx - 1 + cases.length) % cases.length })); }, nextCase: () => { this.caseTick = 0; this.setState(s => ({ caseIdx: (s.caseIdx + 1) % cases.length })); },\n      pauseCases: () => this.setState({ casePaused: true }), resumeCases: () => this.setState({ casePaused: false }),\n      scanClock: lv.scanClock, scanPct: lv.scanPct,\n      scanRows: (lang === 'en' ? EN.rows : this.rows).slice(0, shown).map(r => ({ ...r, status: r.ok ? (lang === 'en' ? 'observed' : 'observado') : (lang === 'en' ? 'with signal' : 'con señal'), color: r.ok ? '#62e8ff' : '#ffc857' })),\n      facts: lang === 'en' ? EN.facts : [\n        { value: '4,44 M$', label: 'coste medio mundial de una brecha de datos en 2025 (10,22 M$ en EE. UU.).', src: 'IBM · COST OF A DATA BREACH 2025', url: S.ibm },\n        { value: '241 días', label: 'de media para identificar y contener una brecha. Casi ocho meses con la puerta abierta.', src: 'IBM · 2025', url: S.ibm },\n        { value: '8 PB', label: 'de historial de navegación acumulados por una filial de un antivirus y vendidos a terceros.', src: 'FTC / TECHRADAR · 2024', url: S.techradar },\n        { value: '3.000 M', label: 'de cuentas de Yahoo afectadas por la brecha de 2013, la mayor conocida hasta hoy.', src: 'SEC · 2018', url: S.yahoo },\n      ],\n      pillars: lang === 'en' ? EN.pillars : [\n        { n: 1, tag: 'La regla primera', title: 'Todo ocurre en tu casa', body: 'Sin cuenta, sin servidor nuestro, cero telemetría. GUARDIANA no contacta ningún servidor nuestro nunca. Las únicas conexiones son las que tú provocas, y cada una queda anotada a la vista.' },\n        { n: 2, tag: 'Los puertos', title: 'Nada abierto hacia internet', body: 'El panel vive en tu PC. Con Modo Hogar, y solo entonces, escucha además en tu red local, nunca en internet. Apagarlo cierra los puertos y el propio programa lo comprueba.' },\n        { n: 3, tag: 'El corte', title: 'Nada se bloquea sin tu decisión', body: 'Nunca antes de 24 horas observando, nunca sin «deshacer» a la vista. Las actualizaciones, la hora, la mensajería y las videollamadas no se cortan aunque lo pidas por categoría.' },\n        { n: 4, tag: 'El lenguaje', title: 'Cada señal, una frase', body: 'Nunca «malicioso». Nunca «100 % seguro». La etiqueta «esperado» pesa lo mismo que «rastreador».' },\n        { n: 5, tag: 'La prueba', title: 'Código abierto y comprobable', body: 'Abierto desde el primer día, compilación reproducible, huella y firma de cada versión en un registro público antes de la descarga.' },\n        { n: 6, tag: 'Las personas', title: 'No vigila personas', body: 'En Modo Hogar el panel de la casa ve totales por aparato. El detalle de un teléfono solo se ve desde ese teléfono, salvo que su dueño lo comparta. No es control parental.' },\n      ],\n      ledger: lang === 'en' ? EN.ledger : [\n        { time: '09:12', title: 'Teléfono A → ads.example-net.com', detail: 'publicidad · destino nuevo para este dispositivo', label: 'OBSERVADO', color: '#9aa3b5' },\n        { time: '10:47', title: 'Televisor → metrics.example-tv.com', detail: 'telemetría · contacta el mismo destino cada 10 minutos, como un latido', label: 'SEÑAL', color: '#ffc857' },\n        { time: '12:03', title: 'Este PC → update.example-os.com', detail: 'esperado · actualización del sistema, no es una fuga', label: 'ESPERADO', color: '#62e8ff' },\n        { time: '15:30', title: 'Tableta → trk.example-affil.io', detail: 'rastreador · cortado por ti a las 15:31, tras 24 h observando', label: 'CORTADO', color: '#ff6b6b' },\n        { time: '17:58', title: 'Teléfono B → dns.example-resolver.com', detail: 'intenta resolver nombres por su cuenta, fuera de la vista de GUARDIANA', label: 'FUERA DE VISTA', color: '#8b7cff' },\n        { time: '18:20', title: 'Deshecho: Tableta → trk.example-affil.io', detail: 'deshacer siempre visible · el corte y el deshacer quedan anotados', label: 'DESHECHO', color: '#9aa3b5' },\n      ],\n      score,\n      reasons: [1, 2, 3, 4].map(n => ({ n: '0' + n, title: t['r' + n], body: t['rb' + n] })),\n      trust: lang === 'en' ? EN.trust : [\n        { code: '01 / CÓDIGO ABIERTO', title: 'Todo el cliente se puede leer', body: 'No hay caja negra. Cada línea que corre en tu máquina será pública desde el primer día.' },\n        { code: '02 / BUILDS REPRODUCIBLES', title: 'El binario es el código', body: 'Cualquiera podrá compilar y obtener el mismo hash que el instalador que descargas. Así verificas sin sello de nadie.' },\n        { code: '03 / REGISTRO PÚBLICO', title: 'Publicado antes que la descarga', body: 'La huella y la firma de cada versión van al registro público (y a Rekor) antes de que el archivo se pueda bajar. Nada se borra, ni por nosotros.' },\n        { code: '04 / SIN CONTENIDO', title: 'Nunca leemos tu tráfico', body: 'Vemos nombres de servicios, hora y dispositivo. Ni contenido, ni cuántos datos, ni qué app lo pidió en un teléfono. Lo decimos en cada pantalla.' },\n        { code: '05 / SIN SERVIDOR', title: 'Superficie mínima', body: 'Sin cuenta de usuario, sin telemetría, sin servidor con tus datos. Lo que no existe no se puede filtrar.' },\n      ],\n      roadmap: lang === 'en' ? EN.roadmap : [\n        { v: '1.0', color: '#62e8ff', text: '5 de octubre de 2026 · Windows y Linux. El PC se vigila a sí mismo; Modo Hogar para teléfonos y tele; extracto encadenado; corte con deshacer; informe semanal; comprobación de la instalación.' },\n        { v: '2.0', color: '#8b7cff', text: 'Qué app pidió cada conexión, en Windows, solo lectura. Incluida en Plus.' },\n        { v: 'Luego', color: '#9aa3b5', text: 'macOS, después de la 2.0. Cobertura fuera de casa: en estudio, sin fecha.' },\n      ],\n      plans: lang === 'en' ? EN.plans : [\n        { name: 'Gratis', price: 'Gratis', period: 'par