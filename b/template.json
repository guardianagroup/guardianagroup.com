5.7, 139.7],\n    'Australia/Perth': [-32.0, 115.9], 'Australia/Adelaide': [-34.9, 138.6], 'Australia/Brisbane': [-27.5, 153.0], 'Australia/Sydney': [-33.9, 151.2], 'Australia/Melbourne': [-37.8, 145.0], 'Pacific/Auckland': [-36.9, 174.8] };\n  // «ANGLE (Apple, ANGLE Metal Renderer: Apple M2, Unspecified Version)» → «Apple M2»\n  cleanGpu(g) {\n    if (!g) return 'no expuesto'; let x = String(g);\n    const m = x.match(/ANGLE\\s*\\(([^)]*)\\)/i); if (m) x = m[1];\n    x = x.replace(/ANGLE Metal Renderer:\\s*/i, '').replace(/(Direct3D\\d+|OpenGL|Vulkan)[^,]*/gi, '').replace(/,?\\s*Unspecified Version/i, '').replace(/\\(R\\)|\\(TM\\)/g, '');\n    const parts = x.split(',').map(p => p.trim()).filter(Boolean);\n    if (parts.length >= 2 && /^(Apple|Intel|NVIDIA|AMD|Qualcomm|ARM|Google|Mesa|Microsoft|Samsung|Imagination)/i.test(parts[0]) && new RegExp('^' + parts[0].split(/\\s/)[0], 'i').test(parts[1])) parts.shift();\n    x = (parts[0] || String(g)).replace(/\\s+/g, ' ').trim();\n    return x.length > 42 ? x.slice(0, 41) + '…' : x;\n  }\n  tzName() { if (!this.tz) { try { this.tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '—'; } catch (e) { this.tz = '—'; } } return this.tz; }\n  // Decodificación del HUD: cada dato aparece como glifos que se fijan carácter a carácter; el contador sube a la vez\n  decodeHud() {\n    const root = this.hudRef.current; if (!root) return;\n    const rows = Array.from(root.querySelectorAll('[data-hud-row]')); if (!rows.length) return;\n    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;\n    const vals = rows.map(r => r.querySelector('[data-hud-val]')), finals = vals.map(v => v ? v.textContent : ''), glyphs = '0123456789ABCDEF░▒▓#%&';\n    const put = (el, txt) => { const c = el.firstChild; if (c && c.nodeType === 3) c.nodeValue = txt; else el.textContent = txt; };\n    rows.forEach(r => { r.style.opacity = '0'; r.style.transform = 'translateX(14px)'; r.style.transition = 'opacity .35s ease, transform .55s cubic-bezier(.2,.7,.2,1)'; });\n    const cnt = this.hudCountRef.current, cntFinal = cnt ? cnt.textContent : '', cm = cntFinal.match(/^\\d+/), total = cm ? +cm[0] : 0;\n    const wait = Math.max(0, (this.introStart || 0) + 900 - performance.now()), gap = 170, dur = 640;\n    setTimeout(() => {\n      const t0 = performance.now();\n      const tick = () => {\n        const now = performance.now(); let resolved = 0, live = false;\n        rows.forEach((r, i) => {\n          const p = (now - t0 - i * gap) / dur; if (p < 0) { live = true; return; }\n          if (r.style.opacity !== '1') { r.style.opacity = '1'; r.style.transform = 'none'; }\n          const v = vals[i], f = finals[i]; if (!v) return;\n          if (p >= 1) { if (v.textContent !== f) put(v, f); resolved++; return; }\n          live = true; const fixed = Math.floor(p * f.length); let out = '';\n          for (let j = 0; j < f.length; j++) out += j < fixed || f[j] === ' ' ? f[j] : glyphs[Math.floor(Math.random() * glyphs.length)];\n          put(v, out);\n        });\n        if (cnt && total) put(cnt, cntFinal.replace(/^\\d+/, String(Math.round(resolved / rows.length * total))));\n        if (live) this.hudRaf = requestAnimationFrame(tick); else { if (cnt) put(cnt, cntFinal); rows.forEach(r => { r.style.transition = ''; r.style.transform = ''; }); }\n      };\n      this.hudRaf = requestAnimationFrame(tick);\n    }, wait);\n  }\n  runIntro() {\n    this.introStart = performance.now();\n    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;\n    const els = Array.from(document.querySelectorAll('[data-intro]'));\n    if (reduce) { els.forEach(el => { el.style.opacity = '1'; }); return; }\n    els.forEach(el => { el.style.opacity = '0'; el.style.transform = 'translateY(18px)'; el.style.filter = 'blur(14px)'; });\n    const scan = this.scanRef.current;\n    if (scan) { scan.style.transition = 'none'; scan.style.opacity = '1'; scan.style.transform = 'translateY(0)'; requestAnimationFrame(() => { scan.style.transition = 'transform 1.5s cubic-bezier(.2,.7,.2,1), opacity .4s ease 1.3s'; scan.style.transform = 'translateY(88vh)'; scan.style.opacity = '0'; }); }\n    els.forEach(el => { const n = +el.dataset.intro; setTimeout(() => { el.style.transition = 'opacity .9s ease, transform 1.1s cubic-bezier(.2,.7,.2,1), filter 1.1s ease'; el.style.opacity = '1'; el.style.transform = 'none'; el.style.filter = 'none'; setTimeout(() => { el.style.filter = ''; el.style.transform = ''; }, 1300); }, 350 + n * 220); });\n    // decodificación del wordmark: glifos aleatorios que se fijan letra a letra\n    const w = this.wordEl.current; if (!w || !w.firstChild || w.firstChild.nodeType !== 3) return;\n    const final = w.firstChild.nodeValue, glyphs = '01<>/\\\\|#%&*+=?ΔΣΩ∆∇◊'; const t0 = performance.now(), dur = 1400, d0 = 700;\n    const tick = () => { const p = Math.min(1, Math.max(0, (performance.now() - t0 - d0) / dur)); const fixed = Math.floor(p * final.length); let out = ''; for (let i = 0; i < final.length; i++) out += i < fixed || final[i] === ' ' ? final[i] : glyphs[Math.floor(Math.random() * glyphs.length)]; if (w.firstChild && w.firstChild.nodeType === 3) w.firstChild.nodeValue = p >= 1 ? final : out; if (p < 1) this.introRaf = requestAnimationFrame(tick); else this.fitWord(); };\n    this.introRaf = requestAnimationFrame(tick);\n  }\n  // ---- Música generativa (Web Audio, original, sin muestras) ----\n  midi = m => 440 * Math.pow(2, (m - 69) / 12);\n  unlockMedia() {\n    try { if (!this.silent) { const a = this.silent = document.createElement('audio'); a.setAttribute('playsinline', ''); a.setAttribute('webkit-playsinline', ''); a.loop = true; a.preload = 'auto'; a.style.display = 'none'; a.src = 'data:audio/mpeg;base64,'; document.body.appendChild(a); } const p = this.silent.play(); if (p && p.catch) p.catch(() => {}); } catch (e) {}\n  }\n  startAudio() {\n    this.unlockMedia();\n    if (this.ac) { try { this.ac.resume(); } catch (e) {} this.master.gain.s